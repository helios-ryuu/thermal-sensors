    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Values read from /etc/mbpfan.conf. No data for periods before the collector started exporting config metrics.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "config valid"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "text": "Error"
                      },
                      "1": {
                        "color": "green",
                        "text": "OK"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(low temp|high temp|max temp)$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(fan min|fan max)$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: RPM"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 4
      },
