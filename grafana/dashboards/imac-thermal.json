    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Intake air temperature measured directly at the bottom chassis grille (Inlet Air TA0V) and ambient room intake temperature.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "mappings": [],
          "max": 40,
          "min": 10,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 18
              },
              {
                "color": "orange",
                "value": 28
              },
              {
                "color": "red",
                "value": 33
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "~room"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "inlet air"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "light-blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 0
      },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "thermal_room_temperature_celsius or avg by (instance, job) (thermal_temperature_celsius{component=\"applesmc\",sensor=\"air_intake\"} + clamp_max(clamp_min((23.5 - thermal_temperature_celsius{component=\"applesmc\",sensor=\"air_intake\"}) * 0.2, 0), 0.4))",
          "instant": true,
          "legendFormat": "~room",
          "refId": "A"
        },
        {
          "expr": "thermal_temperature_celsius{component=\"applesmc\",sensor=\"air_intake\"}",
          "instant": true,
          "legendFormat": "inlet air",
          "refId": "B"
        }
      ],
      "title": "~Room & Inlet Air",
      "type": "stat"
    },
