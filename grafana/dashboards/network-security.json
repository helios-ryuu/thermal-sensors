{
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Cảm biến nhiệt độ iMac",
      "type": "dashboard",
      "url": "/d/imac-thermal"
    },
    {
      "title": "Tài nguyên hệ thống",
      "type": "dashboard",
      "url": "/d/system-resources"
    },
    {
      "title": "Sức khỏe hệ thống",
      "type": "dashboard",
      "url": "/d/system-health"
    }
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Carrier-Grade NAT (CGNAT) detection. Green = Direct Public IP, Yellow = Behind ISP CGNAT (100.64.0.0/10).",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "green", "text": "Public Direct (No CGNAT)"},
                "1": {"color": "yellow", "text": "Behind CGNAT (100.64.0.0/10)"}
              },
              "type": "value"
            }
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "net_nat_is_cgnat", "instant": true, "legendFormat": "CGNAT", "refId": "A"}
      ],
      "title": "CGNAT Status",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "NAT Traversal Behavior. Green = Cone NAT (Direct P2P Friendly), Yellow = Symmetric NAT (Requires Relay).",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "green", "text": "Cone NAT (P2P Friendly)"},
                "1": {"color": "yellow", "text": "Symmetric NAT (Relay Required)"}
              },
              "type": "value"
            }
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "net_nat_is_symmetric", "instant": true, "legendFormat": "NAT Type", "refId": "A"}
      ],
      "title": "NAT Type",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Double NAT detection via hop routing. Green = Single Router (Optimal), Orange = Multi-layer Router Detected.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "green", "text": "Single NAT (Optimal)"},
                "1": {"color": "orange", "text": "Double NAT Detected"}
              },
              "type": "value"
            }
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "net_nat_is_double_nat", "instant": true, "legendFormat": "Double NAT", "refId": "A"}
      ],
      "title": "Double NAT",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Public IPv4 address and detected Internet Service Provider (ISP).",
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "net_wan_info",
          "instant": true,
          "legendFormat": "{{public_ipv4}} ({{isp}})",
          "refId": "A"
        }
      ],
      "title": "Public IPv4 & ISP",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Default router gateway IP and hardware MAC address.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "net_gateway_info",
          "instant": true,
          "legendFormat": "{{gateway_ip}} [{{gateway_mac}}]",
          "refId": "A"
        }
      ],
      "title": "Default Gateway",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Tailscale daemon connection state on iMac.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "text": "Offline"},
                "1": {"color": "green", "text": "Tailscale Online"}
              },
              "type": "value"
            }
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "net_tailscale_status", "instant": true, "legendFormat": "Tailscale", "refId": "A"}
      ],
      "title": "Tailscale Network",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4},
      "id": 100,
      "title": "Topology & Network Quality",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Host network interfaces, operational status, MTU and assigned IP CIDRs.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "color-text"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Interface"}, "properties": [{"id": "custom.width", "value": 140}]},
          {"matcher": {"id": "byName", "options": "Status"}, "properties": [{"id": "custom.width", "value": 120}]},
          {"matcher": {"id": "byName", "options": "MTU"}, "properties": [{"id": "custom.width", "value": 90}]}
        ]
      },
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 5},
      "id": 7,
      "options": {
        "sortBy": [{"desc": false, "displayName": "Interface"}]
      },
      "targets": [
        {
          "expr": "net_interface_info",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Network Interfaces & Subnets",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Interface",
              "state": "Status",
              "mtu": "MTU",
              "ips": "IP Subnets"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "ICMP Ping latency in milliseconds to Gateway, DNS Resolver, and Internet (1.1.1.1).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "gateway"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "dns"}, "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "internet"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 5},
      "id": 8,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "net_ping_latency_ms",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "title": "Network Latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
      "id": 101,
      "title": "Device Inventory (LAN & Tailscale)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Combined real-time inventory of all devices on local LAN (via ARP) and Tailscale virtual private network.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "color-text"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 0}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Network"},
            "properties": [{"id": "custom.width", "value": 110}]
          },
          {
            "matcher": {"id": "byName", "options": "Device Name"},
            "properties": [{"id": "custom.width", "value": 200}]
          },
          {
            "matcher": {"id": "byName", "options": "IP Address"},
            "properties": [{"id": "custom.width", "value": 150}]
          },
          {
            "matcher": {"id": "byName", "options": "Status"},
            "properties": [
              {"id": "custom.width", "value": 120},
              {
                "id": "mappings",
                "value": [
                  {"options": {"online": {"color": "green", "text": "Online"}, "reachable": {"color": "green", "text": "Reachable"}, "offline": {"color": "red", "text": "Offline"}, "stale": {"color": "yellow", "text": "Stale"}}, "type": "value"}
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Link Type"},
            "properties": [{"id": "custom.width", "value": 140}]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "id": 9,
      "options": {
        "sortBy": [{"desc": false, "displayName": "Network"}, {"desc": false, "displayName": "IP Address"}]
      },
      "targets": [
        {
          "expr": "net_device_info",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Unified Device Inventory",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "network": "Network",
              "name": "Device Name",
              "ip": "IP Address",
              "identifier": "Identifier (MAC / OS)",
              "status": "Status",
              "link_type": "Link Type"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 21},
      "id": 102,
      "title": "Ports & Active Connections",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Listening network ports categorized by security exposure: Public / LAN (0.0.0.0), Tailscale Only, or Localhost Only.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "color-text"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Port"}, "properties": [{"id": "custom.width", "value": 90}]},
          {"matcher": {"id": "byName", "options": "Protocol"}, "properties": [{"id": "custom.width", "value": 90}]},
          {"matcher": {"id": "byName", "options": "Bind IP"}, "properties": [{"id": "custom.width", "value": 140}]},
          {
            "matcher": {"id": "byName", "options": "Exposure"},
            "properties": [
              {"id": "custom.width", "value": 160},
              {
                "id": "mappings",
                "value": [
                  {"options": {"Public / LAN": {"color": "orange", "text": "Public / LAN"}, "Tailscale Only": {"color": "green", "text": "Tailscale Only"}, "Localhost Only": {"color": "blue", "text": "Localhost Only"}}, "type": "value"}
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "id": 10,
      "options": {
        "sortBy": [{"desc": false, "displayName": "Port"}]
      },
      "targets": [
        {
          "expr": "net_listening_port_info",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Open Listening Ports",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "port": "Port",
              "proto": "Protocol",
              "bind_ip": "Bind IP",
              "exposure": "Exposure",
              "service": "Service / Process"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Active established connections communicating with services on this iMac.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "color-text"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Proto"}, "properties": [{"id": "custom.width", "value": 80}]},
          {"matcher": {"id": "byName", "options": "Local Port"}, "properties": [{"id": "custom.width", "value": 110}]},
          {"matcher": {"id": "byName", "options": "Remote IP"}, "properties": [{"id": "custom.width", "value": 160}]},
          {"matcher": {"id": "byName", "options": "Remote Port"}, "properties": [{"id": "custom.width", "value": 110}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "id": 11,
      "options": {
        "sortBy": [{"desc": false, "displayName": "Local Port"}]
      },
      "targets": [
        {
          "expr": "net_active_connection_info",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Active Connections",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "proto": "Proto",
              "local_port": "Local Port",
              "remote_ip": "Remote IP",
              "remote_port": "Remote Port",
              "state": "State"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 30},
      "id": 103,
      "title": "Firewall & Host Security",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Kernel sysctl network security defenses.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "green", "text": "Disabled (Secure for Host)"},
                "1": {"color": "blue", "text": "Enabled (Forwarding Active)"}
              },
              "type": "value"
            }
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "tcp_syncookies"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {"options": {"1": {"color": "green", "text": "SYN Flood Protected"}, "0": {"color": "red", "text": "Vulnerable"}}, "type": "value"}
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "accept_redirects"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {"options": {"0": {"color": "green", "text": "Redirects Blocked"}, "1": {"color": "yellow", "text": "Accepting Redirects"}}, "type": "value"}
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "rp_filter"},
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {"options": {"1": {"color": "green", "text": "Anti-Spoofing On"}, "2": {"color": "green", "text": "Anti-Spoofing Loose"}, "0": {"color": "red", "text": "Disabled"}}, "type": "value"}
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 31},
      "id": 12,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "net_security_setting{setting=\"tcp_syncookies\"}", "instant": true, "legendFormat": "tcp_syncookies", "refId": "A"},
        {"expr": "net_security_setting{setting=\"ip_forward\"}", "instant": true, "legendFormat": "ip_forward", "refId": "B"},
        {"expr": "net_security_setting{setting=\"rp_filter\"}", "instant": true, "legendFormat": "rp_filter", "refId": "C"},
        {"expr": "net_security_setting{setting=\"accept_redirects\"}", "instant": true, "legendFormat": "accept_redirects", "refId": "D"}
      ],
      "title": "Host Security Settings",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Active iptables packet filtering rules on host.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "color-text"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Chain"}, "properties": [{"id": "custom.width", "value": 90}]},
          {
            "matcher": {"id": "byName", "options": "Action"},
            "properties": [
              {"id": "custom.width", "value": 90},
              {
                "id": "mappings",
                "value": [
                  {"options": {"ACCEPT": {"color": "green", "text": "ACCEPT"}, "DROP": {"color": "red", "text": "DROP"}, "REJECT": {"color": "red", "text": "REJECT"}}, "type": "value"}
                ]
              }
            ]
          },
          {"matcher": {"id": "byName", "options": "Proto"}, "properties": [{"id": "custom.width", "value": 80}]},
          {"matcher": {"id": "byName", "options": "Packets"}, "properties": [{"id": "custom.width", "value": 100}]},
          {"matcher": {"id": "byName", "options": "Bytes"}, "properties": [{"id": "custom.width", "value": 100}]}
        ]
      },
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 31},
      "id": 13,
      "options": {
        "sortBy": [{"desc": false, "displayName": "Chain"}]
      },
      "targets": [
        {
          "expr": "net_firewall_rule_info",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Firewall & iptables Rules",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "chain": "Chain",
              "target": "Action",
              "proto": "Proto",
              "source": "Source",
              "dest": "Destination",
              "packets": "Packets",
              "bytes": "Bytes",
              "extra": "Match Criteria"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["network", "security", "tailscale", "imac"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Mạng & Bảo mật",
  "uid": "network-security",
  "version": 1
}

