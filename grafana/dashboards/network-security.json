{
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {"title": "Cảm biến nhiệt độ iMac", "type": "dashboard", "url": "/d/imac-thermal"},
    {"title": "Tài nguyên hệ thống",    "type": "dashboard", "url": "/d/system-resources"},
    {"title": "Sức khỏe hệ thống",      "type": "dashboard", "url": "/d/system-health"}
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Carrier-Grade NAT (CGNAT) detection. Green = Direct Public IP, Yellow = Behind ISP CGNAT (100.64.0.0/10).",
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"0": {"color": "green", "text": "Public Direct (No CGNAT)"}, "1": {"color": "yellow", "text": "Behind CGNAT (100.64.0.0/10)"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "net_nat_is_cgnat", "instant": true, "legendFormat": "CGNAT", "refId": "A"}],
      "title": "CGNAT Status",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "NAT Traversal Behavior. Green = Cone NAT (P2P Friendly), Yellow = Symmetric NAT (Relay Required).",
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"0": {"color": "green", "text": "Cone NAT (P2P Friendly)"}, "1": {"color": "yellow", "text": "Symmetric NAT (Relay Required)"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "net_nat_is_symmetric", "instant": true, "legendFormat": "NAT Type", "refId": "A"}],
      "title": "NAT Type",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Double NAT detection via traceroute. Green = Single NAT, Orange = Multi-layer Router Detected.",
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"0": {"color": "green", "text": "Single NAT (Optimal)"}, "1": {"color": "orange", "text": "Double NAT Detected"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "net_nat_is_double_nat", "instant": true, "legendFormat": "Double NAT", "refId": "A"}],
      "title": "Double NAT",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Public IPv4 address and ISP detected via external service.",
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "blue", "mode": "fixed"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 5, "x": 12, "y": 0},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "name"},
      "targets": [{"expr": "net_wan_info", "instant": true, "legendFormat": "{{public_ipv4}} ({{isp}})", "refId": "A"}],
      "title": "Public IPv4 & ISP",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Public IPv6 address detected via curl -6. Shows 'none' if the host has no public IPv6.",
      "fieldConfig": {
        "defaults": {
          "color": {"fixedColor": "purple", "mode": "fixed"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 5, "x": 17, "y": 0},
      "id": 14,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "name"},
      "targets": [{"expr": "net_wan_info", "instant": true, "legendFormat": "{{public_ipv6}}", "refId": "A"}],
      "title": "Public IPv6",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Tailscale daemon connection state.",
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"0": {"color": "red", "text": "Offline"}, "1": {"color": "green", "text": "Online"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 2, "x": 22, "y": 0},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "net_tailscale_status", "instant": true, "legendFormat": "Tailscale", "refId": "A"}],
      "title": "Tailscale",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4},
      "id": 100,
      "title": "Topology & Network Quality",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Host network interfaces, operational status, MTU, type, and IPs. Color: physical=green, vpn=purple, docker=orange, virtual/k8s=grey.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "auto"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Interface"}, "properties": [{"id": "custom.width", "value": 160}]},
          {"matcher": {"id": "byName", "options": "Status"}, "properties": [
            {"id": "custom.width", "value": 110},
            {"id": "custom.displayMode", "value": "color-background"},
            {"id": "mappings", "value": [{"options": {"UP": {"color": "green", "text": "UP"}, "DOWN": {"color": "red", "text": "DOWN"}, "UNKNOWN": {"color": "yellow", "text": "UNKNOWN"}, "LOWERLAYERDOWN": {"color": "orange", "text": "LOWER DOWN"}}, "type": "value"}]}
          ]},
          {"matcher": {"id": "byName", "options": "MTU"}, "properties": [{"id": "custom.width", "value": 80}]},
          {"matcher": {"id": "byName", "options": "Type"}, "properties": [
            {"id": "custom.width", "value": 110},
            {"id": "custom.displayMode", "value": "color-background"},
            {"id": "mappings", "value": [{"options": {"physical": {"color": "green", "text": "physical"}, "wifi": {"color": "blue", "text": "wifi"}, "vpn": {"color": "purple", "text": "vpn"}, "docker": {"color": "orange", "text": "docker"}, "k8s": {"color": "yellow", "text": "k8s"}, "virtual": {"color": "dark-gray", "text": "virtual"}, "other": {"color": "gray", "text": "other"}}, "type": "value"}]}
          ]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 7,
      "options": {"sortBy": [{"desc": false, "displayName": "Type"}, {"desc": false, "displayName": "Interface"}]},
      "targets": [{"expr": "net_interface_info", "format": "table", "instant": true, "legendFormat": "", "refId": "A"}],
      "title": "Network Interfaces & Subnets",
      "transformations": [{
        "id": "organize",
        "options": {
          "renameByName": {"name": "Interface", "state": "Status", "mtu": "MTU", "ips": "IP Subnets", "net_type": "Type"},
          "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true, "Value": true},
          "indexByName": {"Type": 0, "Interface": 1, "Status": 2, "MTU": 3, "IP Subnets": 4}
        }
      }],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "ICMP Ping latency to Gateway, DNS, and Internet (1.1.1.1).",
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never", "gradientMode": "opacity"},
          "unit": "ms",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "orange", "value": 100}, {"color": "red", "value": 200}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "gateway"},  "properties": [{"id": "color", "value": {"fixedColor": "green",  "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "dns"},      "properties": [{"id": "color", "value": {"fixedColor": "blue",   "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "internet"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "net_ping_latency_ms", "legendFormat": "{{target}}", "refId": "A"}],
      "title": "Network Latency",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
      "id": 101,
      "title": "Device Inventory (LAN & Tailscale)",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Unified inventory: LAN (ARP) + Tailscale peers. Network badge: green=LAN, blue=Tailscale. Status: green=reachable/online, yellow=stale, red=offline.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "auto"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Network"}, "properties": [
            {"id": "custom.width", "value": 130},
            {"id": "custom.displayMode", "value": "color-background"},
            {"id": "mappings", "value": [{"options": {"LAN": {"color": "green", "text": "LAN"}, "Tailscale": {"color": "blue", "text": "Tailscale"}}, "type": "value"}]}
          ]},
          {"matcher": {"id": "byName", "options": "Device Name"}, "properties": [{"id": "custom.width", "value": 200}]},
          {"matcher": {"id": "byName", "options": "IP Address"},   "properties": [{"id": "custom.width", "value": 170}]},
          {"matcher": {"id": "byName", "options": "Status"}, "properties": [
            {"id": "custom.width", "value": 130},
            {"id": "custom.displayMode", "value": "color-background"},
            {"id": "mappings", "value": [{"options": {"online": {"color": "green", "text": "Online"}, "reachable": {"color": "green", "text": "Reachable"}, "offline": {"color": "red", "text": "Offline"}, "stale": {"color": "yellow", "text": "Stale"}}, "type": "value"}]}
          ]},
          {"matcher": {"id": "byName", "options": "Link Type"}, "properties": [
            {"id": "custom.width", "value": 140},
            {"id": "custom.displayMode", "value": "color-text"},
            {"id": "mappings", "value": [{"options": {"direct": {"color": "green", "text": "direct"}}, "type": "value"}]}
          ]}
        ]
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 14},
      "id": 9,
      "options": {"sortBy": [{"desc": false, "displayName": "Network"}, {"desc": false, "displayName": "IP Address"}]},
      "targets": [{"expr": "net_device_info", "format": "table", "instant": true, "legendFormat": "", "refId": "A"}],
      "title": "Unified Device Inventory",
      "transformations": [{
        "id": "organize",
        "options": {
          "renameByName": {"network": "Network", "name": "Device Name", "ip": "IP Address", "identifier": "Identifier (MAC / OS)", "status": "Status", "link_type": "Link Type"},
          "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true, "Value": true},
          "indexByName": {"Network": 0, "Status": 1, "IP Address": 2, "Device Name": 3, "Identifier (MAC / OS)": 4, "Link Type": 5}
        }
      }],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 102,
      "title": "Ports & Active Connections",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Listening ports by exposure: red=Public/LAN, green=Tailscale Only, blue=Localhost, orange=Specific LAN.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "auto"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Port"}, "properties": [{"id": "custom.width", "value": 75}]},
          {"matcher": {"id": "byName", "options": "Protocol"}, "properties": [
            {"id": "custom.width", "value": 80},
            {"id": "custom.displayMode", "value": "color-text"},
            {"id": "mappings", "value": [{"options": {"tcp": {"color": "blue", "text": "TCP"}, "udp": {"color": "orange", "text": "UDP"}}, "type": "value"}]}
          ]},
          {"matcher": {"id": "byName", "options": "Bind IP"}, "properties": [{"id": "custom.width", "value": 200}]},
          {"matcher": {"id": "byName", "options": "Exposure"}, "properties": [
            {"id": "custom.width", "value": 165},
            {"id": "custom.displayMode", "value": "color-background"},
            {"id": "mappings", "value": [{"options": {"Public / LAN": {"color": "red", "text": "Public / LAN"}, "Tailscale Only": {"color": "green", "text": "Tailscale Only"}, "Localhost Only": {"color": "blue", "text": "Localhost Only"}, "Specific LAN": {"color": "orange", "text": "Specific LAN"}}, "type": "value"}]}
          ]}
        ]
      },
      "gridPos": {"h": 9, "w": 13, "x": 0, "y": 24},
      "id": 10,
      "options": {"sortBy": [{"desc": false, "displayName": "Exposure"}, {"desc": false, "displayName": "Port"}]},
      "targets": [{"expr": "net_listening_port_info", "format": "table", "instant": true, "legendFormat": "", "refId": "A"}],
      "title": "Open Listening Ports",
      "transformations": [{
        "id": "organize",
        "options": {
          "renameByName": {"port": "Port", "proto": "Protocol", "bind_ip": "Bind IP", "exposure": "Exposure", "service": "Service / Process"},
          "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true, "Value": true},
          "indexByName": {"Exposure": 0, "Port": 1, "Protocol": 2, "Bind IP": 3, "Service / Process": 4}
        }
      }],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Active established connections with remote hosts.",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "auto"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Proto"}, "properties": [
            {"id": "custom.width", "value": 70},
            {"id": "custom.displayMode", "value": "color-text"},
            {"id": "mappings", "value": [{"options": {"tcp": {"color": "blue", "text": "TCP"}, "udp": {"color": "orange", "text": "UDP"}}, "type": "value"}]}
          ]},
          {"matcher": {"id": "byName", "options": "Local Port"},  "properties": [{"id": "custom.width", "value": 100}]},
          {"matcher": {"id": "byName", "options": "Remote IP"},   "properties": [{"id": "custom.width", "value": 210}]},
          {"matcher": {"id": "byName", "options": "Remote Port"}, "properties": [{"id": "custom.width", "value": 100}]},
          {"matcher": {"id": "byName", "options": "State"}, "properties": [
            {"id": "custom.width", "value": 135},
            {"id": "custom.displayMode", "value": "color-background"},
            {"id": "mappings", "value": [{"options": {"ESTABLISHED": {"color": "green", "text": "ESTABLISHED"}, "CLOSE_WAIT": {"color": "yellow", "text": "CLOSE_WAIT"}, "TIME_WAIT": {"color": "orange", "text": "TIME_WAIT"}, "FIN_WAIT": {"color": "red", "text": "FIN_WAIT"}, "LAST_ACK": {"color": "orange", "text": "LAST_ACK"}}, "type": "value"}]}
          ]}
        ]
      },
      "gridPos": {"h": 9, "w": 11, "x": 13, "y": 24},
      "id": 11,
      "options": {"sortBy": [{"desc": false, "displayName": "Local Port"}]},
      "targets": [{"expr": "net_active_connection_info", "format": "table", "instant": true, "legendFormat": "", "refId": "A"}],
      "title": "Active Connections",
      "transformations": [{
        "id": "organize",
        "options": {
          "renameByName": {"proto": "Proto", "local_port": "Local Port", "remote_ip": "Remote IP", "remote_port": "Remote Port", "state": "State"},
          "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true, "Value": true}
        }
      }],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 33},
      "id": 103,
      "title": "Firewall & Host Security",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "SYN Flood protection. Green = Protected, Red = Vulnerable.",
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"1": {"color": "green", "text": "SYN Flood Protected"}, "0": {"color": "red", "text": "Vulnerable"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 34},
      "id": 15,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "net_security_setting{setting=\"tcp_syncookies\"}", "instant": true, "legendFormat": "tcp_syncookies", "refId": "A"}],
      "title": "tcp_syncookies",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "IP forwarding kernel setting. Blue = Enabled (router/k8s mode), Green = Disabled (secure host mode).",
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"1": {"color": "blue", "text": "Forwarding Active"}, "0": {"color": "green", "text": "Disabled (Secure)"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 34},
      "id": 16,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "net_security_setting{setting=\"ip_forward\"}", "instant": true, "legendFormat": "ip_forward", "refId": "B"}],
      "title": "ip_forward",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Reverse path filter — anti-IP-spoofing. Green = Strict/Loose enabled, Red = Disabled.",
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"1": {"color": "green", "text": "Anti-Spoofing Strict"}, "2": {"color": "green", "text": "Anti-Spoofing Loose"}, "0": {"color": "red", "text": "Disabled"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 34},
      "id": 17,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "net_security_setting{setting=\"rp_filter\"}", "instant": true, "legendFormat": "rp_filter", "refId": "C"}],
      "title": "rp_filter",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "ICMP redirect acceptance. Green = Blocked (safe), Yellow = Accepting redirects.",
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"0": {"color": "green", "text": "Redirects Blocked"}, "1": {"color": "yellow", "text": "Accepting Redirects"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 34},
      "id": 18,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "net_security_setting{setting=\"accept_redirects\"}", "instant": true, "legendFormat": "accept_redirects", "refId": "D"}],
      "title": "accept_redirects",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Active TCP/UDP connection states over time. Green=ESTABLISHED, orange=TIME_WAIT, yellow=CLOSE_WAIT, red=FIN_WAIT.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 65, "gradientMode": "none", "lineWidth": 0, "drawStyle": "bars"},
          "unit": "short"
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "established"}, "properties": [{"id": "color", "value": {"fixedColor": "green",  "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "time_wait"},   "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "close_wait"},  "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "syn_sent"},    "properties": [{"id": "color", "value": {"fixedColor": "blue",   "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "fin_wait"},    "properties": [{"id": "color", "value": {"fixedColor": "red",    "mode": "fixed"}}]}
        ]
      },
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 39},
      "id": 19,
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "net_active_connections_total", "legendFormat": "{{state}}", "refId": "A"}],
      "title": "Connection State Distribution",
      "type": "timeseries"
