# ==============================================================================
# Thermal Sensors & System Monitoring - Environment Configuration
# ==============================================================================

# Thư mục lưu trữ tập trung dữ liệu (Prometheus TSDB, Grafana DB, textfile)
# Khuyến nghị: đường dẫn tuyệt đối hoặc /home/user/.sens
SENS_DATA_DIR=/home/user/.sens

# Tài khoản & Mật khẩu Admin Grafana (cài đặt trực tiếp từ file này)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_admin_password_123

# Binding địa chỉ IP và Port cho Grafana (Địa chỉ IP Tailscale của máy)
GRAFANA_BIND_IP=
GRAFANA_PORT=3000

# Binding địa chỉ IP và Port cho Prometheus (chỉ local host)
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090

# Chu kỳ thu thập cảm biến của collector container (giây)
COLLECTOR_INTERVAL=10

# Cấu hình lưu trữ Prometheus
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB

# Đường dẫn file mbpfan.conf trên host (nếu có)
MBPFAN_CONF_PATH=/etc/mbpfan.conf
