# ==============================================================================
# Thermal Sensors Monitoring - Environment Configuration
# ==============================================================================

# Thư mục lưu trữ tập trung dữ liệu (Prometheus TSDB, Grafana DB, textfile, secrets)
# Khuyến nghị: đường dẫn tuyệt đối hoặc ${HOME}/.sens
SENS_DATA_DIR=/home/user/.sens

# Binding địa chỉ IP và Port cho Grafana (Tailscale IP hoặc 127.0.0.1 hoặc 0.0.0.0)
GRAFANA_BIND_IP=
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# Binding địa chỉ IP và Port cho Prometheus (chỉ local host)
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090

# Chu kỳ thu thập cảm biến của collector container (giây)
COLLECTOR_INTERVAL=10

# Cấu hình lưu trữ Prometheus
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB

# Đường dẫn file mbpfan.conf trên host (nếu có)
MBPFAN_CONF_PATH=/etc/mbpfan.conf

